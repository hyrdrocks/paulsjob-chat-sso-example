# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These are for running locally. The hosted demo sets the same names as Cloudflare
# Worker secrets/vars instead (see wrangler.jsonc) — there is no .env in production.

# ── From Chrysus → Settings → SSO Key → Generate key pair ────────────────────
# The private key is shown ONCE, at generation. It must never reach the browser.
# Keep the literal \n escapes, or paste a real multi-line PEM — both work.
SSO_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...replace me...\n-----END RSA PRIVATE KEY-----"

# The `kid` of that key pair, shown beside it in Chrysus (e.g. 20260101-a1b2).
# The widget API uses this to find your company's public key. Nothing else identifies you.
SSO_KEY_ID="YYYYMMDD-xxxx"

# ── Your company ────────────────────────────────────────────────────────────
# Your company slug — the subdomain of your Paul's Job dashboard.
# e.g. https://acme.app.paulsjob.ai  ->  acme
COMPANY_SLUG="your-company-slug"

# ── Your widget SDK ─────────────────────────────────────────────────────────
# The SDK is served from your company's OWN widget domain, which also serves the
# iframes the widget opens (/chat/...).
#
#   Production: https://<company-slug>.chatbot.app.paulsjob.ai/sdk.iife.js
#   Staging:    https://<company-slug>.staging.chatbot.app.paulsjob.ai/sdk.iife.js
#
# The two are pinned to different APIs: production verifies tokens against
# api.paulsjob.ai, staging against staging-api.paulsjob.ai. A key pair generated in
# staging Chrysus ONLY works with the staging SDK, and vice versa — mixing them
# fails with "Invalid key pair".
WIDGET_SDK_URL="https://your-company-slug.chatbot.app.paulsjob.ai/sdk.iife.js"

# The `domain` option passed to the widget config. Defaults to the origin of
# WIDGET_SDK_URL, which is what you want unless you serve the script from elsewhere.
#
# Why it matters: the widget opens its iframes at `<domain>/chat/...`. Leave it unset
# on an external site and the widget looks for them on YOUR origin (/chat/... → 404),
# and the backend sees your site's Origin, which it cannot map to a company.
# WIDGET_DOMAIN="https://your-company-slug.chatbot.app.paulsjob.ai"

# "true" for your own staff, "false" for external applicants.
# Drives EmployeeOrCandidate on the verify call.
EMPLOYEE_MODE="true"

PORT=3000
