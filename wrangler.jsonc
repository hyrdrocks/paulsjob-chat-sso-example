{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paulsjob-chat-sso-example",
  "main": "worker.mjs",
  // >= 2025-09-01 auto-enables enable_nodejs_http_server_modules, which
  // httpServerHandler needs to run the Express app in server.js.
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serves public/ directly; the Worker handles the API routes below it.
  "assets": { "directory": "./public" },
  // Express imports body-parser -> iconv-lite at load time, which does not bundle for
  // Workers. This app never parses a request body, so the stub is never called.
  // See iconv-lite-stub.mjs.
  "alias": { "iconv-lite": "./iconv-lite-stub.mjs" },
  "observability": { "enabled": true },
  // Nothing tenant-specific is committed here — no company slug, no key.
  // The hosted demo's values live in Cloudflare and are set once, out of band:
  //
  //   wrangler secret put SSO_PRIVATE_KEY     # the signing key
  //   wrangler secret put SSO_KEY_ID          # its kid
  //   # COMPANY_SLUG / WIDGET_SDK_URL / EMPLOYEE_MODE: set as vars in the dashboard
  //
  // keep_vars stops each deploy from wiping the dashboard vars. If you deploy your
  // own copy and set none of these, server.js throws at boot naming the missing one.
  "keep_vars": true
}
